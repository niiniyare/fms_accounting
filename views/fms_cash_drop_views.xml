<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         fms.cash.drop — inline list only (used inside shift form)
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_fms_cash_drop_list" model="ir.ui.view">
        <field name="name">fms.cash.drop.list</field>
        <field name="model">fms.cash.drop</field>
        <field name="arch" type="xml">
            <list string="Cash Drops" editable="bottom">
                <field name="attendant_id"
                       domain="[('fms_is_attendant','=',True)]"/>
                <field name="amount" sum="Total"/>
                <field name="dropped_at"/>
                <field name="note" optional="show"/>
                <field name="name" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Inject Cash Drops tab into the shift form beside Tank Dips
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_fms_shift_form_cash_drop_inherit" model="ir.ui.view">
        <field name="name">fms.shift.form.cash.drop.inherit</field>
        <field name="model">fms.shift</field>
        <field name="inherit_id" ref="fms.view_fms_shift_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dips']" position="after">
                <page string="Cash Drops" name="cash_drops">
                    <field name="cash_drop_ids"
                           readonly="state == 'closed'"
                           context="{'default_shift_id': id}">
                        <list editable="bottom" string="Cash Drops">
                            <field name="attendant_id"
                                   domain="[('fms_is_attendant','=',True)]"/>
                            <field name="amount" sum="Total Dropped"/>
                            <field name="dropped_at"/>
                            <field name="note" optional="show"/>
                            <field name="name" readonly="1" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
