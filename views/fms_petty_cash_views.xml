<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Petty Cash Transactions = outbound cash payments (Odoo core account.payment) -->
    <record id="action_fms_petty_cash_disbursements" model="ir.actions.act_window">
        <field name="name">Petty Cash Transactions</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'cash'), ('payment_type', '=', 'outbound')]</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier'}</field>
    </record>

    <menuitem id="menu_fms_petty_cash_transactions"
              name="Petty Cash Transactions"
              parent="fms_accounting.menu_fms_accounting"
              action="action_fms_petty_cash_disbursements"
              groups="fms.group_fms_supervisor"
              sequence="30"/>

</odoo>
