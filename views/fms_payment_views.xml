<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend account.payment form: add FMS context fields in a dedicated tab -->
    <record id="view_fms_payment_form" model="ir.ui.view">
        <field name="name">account.payment.fms.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="FMS Context" name="fms_context">
                    <group>
                        <group string="Shift Linkage">
                            <field name="fms_shift_id"
                                   domain="[('company_id', '=', company_id), ('state', 'in', ['open', 'closing', 'disputed'])]"
                                   options="{'no_create': True}"/>
                            <field name="fms_station_id" readonly="1"/>
                            <field name="fms_attendant_id"
                                   domain="[('fms_is_attendant', '=', True)]"
                                   invisible="not fms_shift_id"/>
                        </group>
                        <group string="Classification">
                            <field name="fms_payment_context"
                                   invisible="not fms_shift_id"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Extend account.payment list: show FMS columns when present -->
    <record id="view_fms_payment_list" model="ir.ui.view">
        <field name="name">account.payment.fms.list</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="fms_shift_id" optional="show"/>
                <field name="fms_payment_context" optional="show"/>
                <field name="fms_attendant_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Standalone list action: Customer Receipts linked to FMS shifts -->
    <record id="action_fms_customer_receipts" model="ir.actions.act_window">
        <field name="name">Customer Receipts</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fms_shift_id', '!=', False), ('fms_payment_context', '=', 'customer_receipt'), ('payment_type', '=', 'inbound')]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_fms_payment_context': 'customer_receipt'}</field>
    </record>

    <!-- Standalone list action: Vendor Payments from shift cash -->
    <record id="action_fms_vendor_payments" model="ir.actions.act_window">
        <field name="name">Vendor Payments (from Shift Cash)</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fms_shift_id', '!=', False), ('fms_payment_context', '=', 'vendor_payment'), ('payment_type', '=', 'outbound')]</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_fms_payment_context': 'vendor_payment'}</field>
    </record>

    <!-- Standalone list action: Cash Floats -->
    <record id="action_fms_cash_floats" model="ir.actions.act_window">
        <field name="name">Cash Floats</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fms_shift_id', '!=', False), ('fms_payment_context', '=', 'cash_float')]</field>
        <field name="context">{'default_fms_payment_context': 'cash_float'}</field>
    </record>

    <!-- Standalone list action: Cash Drops / Pickups -->
    <record id="action_fms_cash_drops" model="ir.actions.act_window">
        <field name="name">Cash Drops / Pickups</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fms_shift_id', '!=', False), ('fms_payment_context', 'in', ['cash_drop', 'cash_pickup'])]</field>
        <field name="context">{'default_fms_payment_context': 'cash_drop'}</field>
    </record>

    <!-- Standalone list action: Expenses from shift cash -->
    <record id="action_fms_shift_expenses" model="ir.actions.act_window">
        <field name="name">Shift Expenses</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fms_shift_id', '!=', False), ('fms_payment_context', '=', 'expense')]</field>
        <field name="context">{'default_payment_type': 'outbound', 'default_fms_payment_context': 'expense'}</field>
    </record>

    <!-- All FMS-linked cash movements (floats, drops, expenses, vendor) -->
    <record id="action_fms_cash_movements" model="ir.actions.act_window">
        <field name="name">Cash Movements</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fms_shift_id', '!=', False), ('fms_payment_context', '!=', 'customer_receipt')]</field>
    </record>

    <!-- Customer Invoices — native Odoo, FMS context filter -->
    <record id="action_fms_customer_invoices" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'default_fms_shift_id': active_id
        }</field>
    </record>

    <!-- Inventory shortcuts — native Odoo models -->
    <record id="action_fms_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fms_stock_receipts" model="ir.actions.act_window">
        <field name="name">Stock Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming')]</field>
        <field name="context">{'default_picking_type_code': 'incoming'}</field>
    </record>

    <record id="action_fms_stock_adjustments" model="ir.actions.act_window">
        <field name="name">Stock Adjustments</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'inventory_mode': True}</field>
    </record>

</odoo>
