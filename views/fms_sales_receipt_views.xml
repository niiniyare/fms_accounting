<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Sales Receipt — list view
    ================================================================ -->

    <record id="view_fms_sales_receipt_list" model="ir.ui.view">
        <field name="name">fms.sales.receipt.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Sales Receipts"
                  decoration-muted="state == 'cancel'"
                  decoration-success="state == 'posted'"
                  default_order="invoice_date desc, name desc">
                <field name="name"              string="Receipt #"/>
                <field name="fms_receipt_no"    string="Physical Receipt" optional="show"/>
                <field name="invoice_date"      string="Date"/>
                <field name="fms_shift_id"      string="Shift"/>
                <field name="fms_attendant_id"  string="Attendant"/>
                <field name="partner_id"        string="Customer"/>
                <field name="fms_vehicle_reg"   string="Vehicle Reg"   optional="show"/>
                <field name="fms_card_number"   string="Card/Cheque"   optional="show"/>
                <field name="amount_total"      string="Total (KES)"   sum="Total"/>
                <field name="state"             widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Sales Receipt — form view (focused forecourt layout)
    ================================================================ -->

    <record id="view_fms_sales_receipt_form" model="ir.ui.view">
        <field name="name">fms.sales.receipt.form</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <form string="Sales Receipt">

                <header>
                    <button name="action_post"  string="Confirm"        type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="button_draft" string="Reset to Draft" type="object"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Forecourt">
                            <field name="invoice_date"     string="Date"
                                   readonly="state != 'draft'"/>
                            <field name="fms_shift_id"     string="Shift"
                                   readonly="state != 'draft'"
                                   required="move_type == 'out_receipt'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <div class="alert alert-warning py-1 px-2 mb-0"
                                 role="alert"
                                 invisible="fms_shift_id != False or state != 'draft'">
                                No open shift found for today. Open a shift first.
                            </div>
                            <field name="fms_attendant_id" string="Attendant"
                                   required="move_type == 'out_receipt'"
                                   readonly="state != 'draft'"/>
                            <field name="fms_vehicle_reg"  string="Vehicle Reg"
                                   placeholder="e.g. KBZ 123X"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Transaction">
                            <field name="partner_id"     string="Customer"
                                   readonly="state != 'draft'"/>
                            <field name="journal_id"     string="Payment Method"
                                   readonly="state != 'draft'"
                                   domain="[('type', 'in', ('cash', 'bank'))]"
                                   options="{'no_create': True}"/>
                            <field name="fms_receipt_no" string="Physical Receipt No"
                                   placeholder="Slip / pump receipt number"
                                   readonly="state != 'draft'"/>
                            <field name="fms_card_number" string="Card / Cheque Ref"
                                   placeholder="Last 4 digits or confirmation code"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="move_type"   invisible="1"/>
                            <field name="company_id"  invisible="1"/>
                        </group>
                    </group>

                    <!-- Lines -->
                    <field name="invoice_line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="product_id"      string="Product"      required="1"/>
                            <field name="fms_line_amount" string="Amount (KES)"/>
                            <field name="price_unit"      string="Price / Litre"/>
                            <field name="quantity"        string="Litres"       optional="show"/>
                            <field name="tax_ids"         string="Tax"          optional="show"/>
                            <field name="price_subtotal"  string="Subtotal"     readonly="1"/>
                        </list>
                    </field>

                    <!-- Totals — live tax computation via native widget -->
                    <field name="tax_totals" widget="account-tax-totals-field"
                           readonly="state != 'draft'" nolabel="1"/>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- ================================================================
         Sales Receipt — search view
    ================================================================ -->

    <record id="view_fms_sales_receipt_search" model="ir.ui.view">
        <field name="name">fms.sales.receipt.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Sales Receipts">
                <field name="name"             string="Receipt #"/>
                <field name="fms_receipt_no"   string="Physical Receipt No"/>
                <field name="fms_card_number"  string="Card / Cheque Ref"/>
                <field name="partner_id"       string="Customer"/>
                <field name="fms_shift_id"     string="Shift"/>
                <field name="fms_attendant_id" string="Attendant"/>
                <field name="fms_vehicle_reg"  string="Vehicle Reg"/>
                <!-- Default: current open shift for today -->
                <filter name="current_shift" string="Current Shift"
                        domain="[('fms_shift_id.state','=','open'),
                                 ('fms_shift_id.date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="draft"  string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="posted" string="Confirmed"
                        domain="[('state','=','posted')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('invoice_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('invoice_date','&gt;=',context_today() + relativedelta(day=1))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="by_shift"       string="Shift"
                            context="{'group_by': 'fms_shift_id'}"/>
                    <filter name="by_attendant"   string="Attendant"
                            context="{'group_by': 'fms_attendant_id'}"/>
                    <filter name="by_journal"     string="Payment Method"
                            context="{'group_by': 'journal_id'}"/>
                    <filter name="by_date"        string="Date"
                            context="{'group_by': 'invoice_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         Action — default to current shift filter
    ================================================================ -->

    <record id="action_fms_sales_receipt" model="ir.actions.act_window">
        <field name="name">Sales Receipts</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_receipt')]</field>
        <field name="context">{
            'default_move_type':          'out_receipt',
            'search_default_current_shift': 1
        }</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fms_sales_receipt_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_fms_sales_receipt_form')}),
        ]"/>
        <field name="search_view_id" ref="view_fms_sales_receipt_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sales receipts yet.</p>
            <p>Create a receipt for each fuel sale transaction.</p>
        </field>
    </record>

    <!-- ================================================================
         Menu — Operations > Sales Receipts
    ================================================================ -->

    <menuitem id="menu_fms_sales_receipts"
              name="Sales Receipts"
              parent="fms.menu_fms_operations"
              action="action_fms_sales_receipt"
              groups="fms.group_fms_attendant"
              sequence="20"/>

</odoo>
