<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend account.move form to show vehicle + driver on customer invoices -->
    <record id="view_account_move_fms_fields" model="ir.ui.view">
        <field name="name">account.move.form.fms</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="fms_vehicle" string="Vehicle / Plate"
                       invisible="move_type not in ('out_invoice','out_refund')"/>
                <field name="fms_driver" string="Driver"
                       invisible="move_type not in ('out_invoice','out_refund')"/>
            </xpath>
        </field>
    </record>

    <!-- Action: customer invoices (credit sales) with FMS fields -->
    <record id="action_fms_credit_customer" model="ir.actions.act_window">
        <field name="name">Credit Customers</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <!-- Accounting submenu (Credit Customers, PDC, Petty Cash) -->
    <menuitem id="menu_fms_accounting"
              name="Accounting"
              parent="fms.menu_fms_root"
              groups="fms.group_fms_supervisor"
              sequence="30"/>

    <menuitem id="menu_fms_credit_customers"
              name="Credit Customers"
              parent="menu_fms_accounting"
              action="action_fms_credit_customer"
              groups="fms.group_fms_supervisor"
              sequence="10"/>

</odoo>
