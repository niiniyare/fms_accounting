<?xml version="1.0" encoding="utf-8"?>
<!--
    fms_accounting_company_defaults.xml — accounting-module defaults.
    Loads ONLY when fms_accounting (which depends on account) is installed.

    All GL accounts, journal, tax group, and taxes are created via
    _ensure_fms_gl_setup() using find-or-create — safe for fresh installs
    and existing DBs that already have these records from a prior version.
-->
<odoo>
    <data noupdate="1">

        <!-- Set fiscal country to Kenya (requires account module).
             This is the one thing safe as a <record> — updating res.company
             with a Many2one is idempotent (no uniqueness constraint). -->
        <record id="base.main_company" model="res.company">
            <field name="account_fiscal_country_id" ref="base.ke"/>
        </record>

    </data>

    <!-- All other accounting defaults via find-or-create Python function.
         noupdate="0" so it runs on every upgrade and keeps records wired. -->
    <data noupdate="0">
        <function model="fms.site.preferences" name="_ensure_fms_gl_setup"/>
    </data>

</odoo>
