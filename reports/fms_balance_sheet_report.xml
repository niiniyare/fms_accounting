<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fms_balance_sheet_document">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
            <t t-set="data" t-value="doc.get_report_data()"/>
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #000;">

                <!-- Company + Title -->
                <div style="text-align:center; margin-bottom:18px;">
                    <div style="font-weight:700; font-size:11pt;">
                        <t t-out="data['wizard'].company_id.name"/>
                    </div>
                    <div style="font-weight:700; font-size:11pt; margin-top:4px;">
                        BALANCE SHEET
                    </div>
                    <div style="font-size:9pt; margin-top:3px; color:#333;">
                        As of <t t-out="data['wizard'].date_to"/>
                        <t t-if="data['wizard'].target_move == 'posted'"> — Posted Entries Only</t>
                        <t t-else=""> — All Entries</t>
                        <t t-if="not data['balanced']">
                            <span style="color:#c00; font-weight:700;"> — OUT OF BALANCE</span>
                        </t>
                    </div>
                </div>

                <table style="width:100%; border-collapse:collapse; font-size:10pt;">
                    <col style="width:60%;"/>
                    <col style="width:20%; text-align:right;"/>
                    <col style="width:20%; text-align:right;"/>

                    <!-- ══ ASSETS ═══════════════════════════════════════════ -->
                    <tbody>
                        <tr style="border-top:2px solid #000; border-bottom:2px solid #000;">
                            <th colspan="3" style="padding:5px 4px; font-weight:700; text-align:center; letter-spacing:1px;">
                                ASSETS
                            </th>
                        </tr>

                        <!-- Current Assets -->
                        <tr>
                            <td colspan="3" style="padding:8px 4px 3px 0; font-weight:700;">
                                Current assets:
                            </td>
                        </tr>
                        <t t-foreach="data['asset_cur_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 8px; color:#555; font-size:9pt;"><t t-out="row['code']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['asset_cur_rows']">
                            <tr><td colspan="3" style="padding:2px 4px 2px 16px; color:#777;">—</td></tr>
                        </t>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total current assets</td>
                            <td></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_asset_current'])"/></td>
                        </tr>

                        <tr><td colspan="3" style="padding:5px;"></td></tr>

                        <!-- Non-Current Assets -->
                        <tr>
                            <td colspan="3" style="padding:4px 4px 3px 0; font-weight:700;">
                                Non-current assets:
                            </td>
                        </tr>
                        <t t-foreach="data['asset_fix_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 8px; color:#555; font-size:9pt;"><t t-out="row['code']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['asset_fix_rows']">
                            <tr><td colspan="3" style="padding:2px 4px 2px 16px; color:#777;">—</td></tr>
                        </t>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total non-current assets</td>
                            <td></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_asset_fixed'])"/></td>
                        </tr>

                        <tr><td colspan="3" style="padding:3px;"></td></tr>

                        <!-- Total Assets -->
                        <tr style="border-top:2px solid #000; border-bottom:3px double #000;">
                            <td style="padding:5px 4px 5px 0; font-weight:700;">Total assets</td>
                            <td></td>
                            <td style="text-align:right; padding:5px 4px; font-weight:700;">
                                <t t-out="'{:,.2f}'.format(data['total_assets'])"/>
                            </td>
                        </tr>

                        <!-- Spacer between sections -->
                        <tr><td colspan="3" style="padding:14px;"></td></tr>

                        <!-- ══ LIABILITIES AND EQUITY ════════════════════════ -->
                        <tr style="border-top:2px solid #000; border-bottom:2px solid #000;">
                            <th colspan="3" style="padding:5px 4px; font-weight:700; text-align:center; letter-spacing:1px;">
                                LIABILITIES AND SHAREHOLDERS' EQUITY
                            </th>
                        </tr>

                        <!-- Current Liabilities -->
                        <tr>
                            <td colspan="3" style="padding:8px 4px 3px 0; font-weight:700;">
                                Current liabilities:
                            </td>
                        </tr>
                        <t t-foreach="data['liab_cur_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 8px; color:#555; font-size:9pt;"><t t-out="row['code']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['liab_cur_rows']">
                            <tr><td colspan="3" style="padding:2px 4px 2px 16px; color:#777;">—</td></tr>
                        </t>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total current liabilities</td>
                            <td></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_liab_cur'])"/></td>
                        </tr>

                        <tr><td colspan="3" style="padding:5px;"></td></tr>

                        <!-- Non-Current Liabilities -->
                        <tr>
                            <td colspan="3" style="padding:4px 4px 3px 0; font-weight:700;">
                                Non-current liabilities:
                            </td>
                        </tr>
                        <t t-foreach="data['liab_lt_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 8px; color:#555; font-size:9pt;"><t t-out="row['code']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['liab_lt_rows']">
                            <tr><td colspan="3" style="padding:2px 4px 2px 16px; color:#777;">—</td></tr>
                        </t>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total non-current liabilities</td>
                            <td></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_liab_lt'])"/></td>
                        </tr>

                        <!-- Total Liabilities -->
                        <tr style="border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:4px 4px 4px 0; font-weight:700;">Total liabilities</td>
                            <td></td>
                            <td style="text-align:right; padding:4px; font-weight:700;">
                                <t t-out="'{:,.2f}'.format(data['total_liab_cur'] + data['total_liab_lt'])"/>
                            </td>
                        </tr>

                        <tr><td colspan="3" style="padding:5px;"></td></tr>

                        <!-- Shareholders' Equity -->
                        <tr>
                            <td colspan="3" style="padding:4px 4px 3px 0; font-weight:700;">
                                Shareholders' equity:
                            </td>
                        </tr>
                        <t t-foreach="data['equity_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 8px; color:#555; font-size:9pt;"><t t-out="row['code']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['equity_rows']">
                            <tr><td colspan="3" style="padding:2px 4px 2px 16px; color:#777;">—</td></tr>
                        </t>
                        <!-- Current year P&L -->
                        <tr>
                            <td style="padding:2px 4px 2px 16px; font-style:italic;">Current year profit / (loss)</td>
                            <td></td>
                            <td style="text-align:right; padding:2px 4px; font-style:italic;">
                                <t t-out="'{:,.2f}'.format(data['current_year_profit'])"/>
                            </td>
                        </tr>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total shareholders' equity</td>
                            <td></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_equity'])"/></td>
                        </tr>

                        <tr><td colspan="3" style="padding:3px;"></td></tr>

                        <!-- Total Liabilities + Equity -->
                        <tr style="border-top:2px solid #000; border-bottom:3px double #000;">
                            <td style="padding:5px 4px 5px 0; font-weight:700;">Total liabilities and shareholders' equity</td>
                            <td></td>
                            <td style="text-align:right; padding:5px 4px; font-weight:700;">
                                <t t-out="'{:,.2f}'.format(data['total_liab_equity'])"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p style="font-size:8pt; color:#555; margin-top:20px; border-top:1px solid #ccc; padding-top:6px;">
                    All amounts in <t t-out="data['currency'].name"/>.
                    Generated by FMS Accounting.
                </p>
            </div>
        </t>
        </t>
        </t>
    </template>

    <record id="action_report_fms_balance_sheet" model="ir.actions.report">
        <field name="name">Balance Sheet</field>
        <field name="model">fms.report.balance.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fms_accounting.report_fms_balance_sheet_document</field>
        <field name="report_file">fms_accounting.report_fms_balance_sheet_document</field>
        <field name="binding_model_id" ref="model_fms_report_balance_sheet"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
