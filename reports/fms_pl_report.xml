<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fms_pl_document">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
            <t t-set="data" t-value="doc.get_report_data()"/>
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #000;">

                <!-- Company + Title -->
                <div style="text-align:center; margin-bottom:18px;">
                    <div style="font-weight:700; font-size:11pt;">
                        <t t-out="data['wizard'].company_id.name"/>
                    </div>
                    <div style="font-weight:700; font-size:11pt; margin-top:4px;">
                        PROFIT AND LOSS STATEMENT
                    </div>
                    <div style="font-size:9pt; margin-top:3px; color:#333;">
                        <t t-if="data['wizard'].date_from">
                            For the period <t t-out="data['wizard'].date_from"/> to
                        </t>
                        <t t-out="data['wizard'].date_to"/>
                        <t t-if="data['wizard'].target_move == 'posted'"> — Posted Entries Only</t>
                        <t t-else=""> — All Entries</t>
                    </div>
                </div>

                <!-- ── REVENUE ───────────────────────────────────────────── -->
                <table style="width:100%; border-collapse:collapse; font-size:10pt;">
                    <col style="width:55%;"/>
                    <col style="width:15%; text-align:right;"/>
                    <col style="width:15%; text-align:right;"/>
                    <col style="width:15%; text-align:right;"/>
                    <thead>
                        <tr style="border-bottom:2px solid #000;">
                            <th style="text-align:left; padding:4px 4px 4px 0;"></th>
                            <th style="text-align:right; padding:4px;">Debit</th>
                            <th style="text-align:right; padding:4px;">Credit</th>
                            <th style="text-align:right; padding:4px; font-weight:700;">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Revenue section header -->
                        <tr>
                            <td colspan="4" style="padding:8px 4px 3px 0; font-weight:700; font-size:10pt; border-top:1px solid #000;">
                                Revenue:
                            </td>
                        </tr>
                        <t t-foreach="data['income_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['code']"/> — <t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['debit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['credit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['income_rows']">
                            <tr>
                                <td colspan="4" style="padding:2px 4px 2px 16px; color:#777;">No revenue entries for this period.</td>
                            </tr>
                        </t>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total Revenue</td>
                            <td style="text-align:right; padding:3px 4px;"></td>
                            <td style="text-align:right; padding:3px 4px;"></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_income'])"/></td>
                        </tr>

                        <!-- Spacer -->
                        <tr><td colspan="4" style="padding:6px;"></td></tr>

                        <!-- Cost of Sales section header -->
                        <tr>
                            <td colspan="4" style="padding:4px 4px 3px 0; font-weight:700; border-top:1px solid #000;">
                                Cost of Sales:
                            </td>
                        </tr>
                        <t t-foreach="data['cogs_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['code']"/> — <t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['debit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['credit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['cogs_rows']">
                            <tr>
                                <td colspan="4" style="padding:2px 4px 2px 16px; color:#777;">No cost of sales entries.</td>
                            </tr>
                        </t>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total Cost of Sales</td>
                            <td style="text-align:right; padding:3px 4px;"></td>
                            <td style="text-align:right; padding:3px 4px;"></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_cogs'])"/></td>
                        </tr>

                        <!-- Gross Profit -->
                        <tr style="border-bottom:2px solid #000;">
                            <td style="padding:5px 4px 5px 0; font-weight:700;">Gross Profit</td>
                            <td></td><td></td>
                            <td style="text-align:right; padding:5px 4px; font-weight:700;
                                border-top:1px solid #000;">
                                <t t-out="'{:,.2f}'.format(data['gross_profit'])"/>
                            </td>
                        </tr>

                        <!-- Spacer -->
                        <tr><td colspan="4" style="padding:6px;"></td></tr>

                        <!-- Operating Expenses -->
                        <tr>
                            <td colspan="4" style="padding:4px 4px 3px 0; font-weight:700; border-top:1px solid #000;">
                                Operating Expenses:
                            </td>
                        </tr>
                        <t t-foreach="data['expense_rows']" t-as="row">
                            <tr>
                                <td style="padding:2px 4px 2px 16px;"><t t-out="row['code']"/> — <t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['debit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['credit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['balance'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['expense_rows']">
                            <tr>
                                <td colspan="4" style="padding:2px 4px 2px 16px; color:#777;">No operating expense entries.</td>
                            </tr>
                        </t>
                        <tr style="background:#f0f0f0; border-top:1px solid #000; border-bottom:1px solid #000;">
                            <td style="padding:3px 4px 3px 16px; font-weight:700;">Total Operating Expenses</td>
                            <td style="text-align:right; padding:3px 4px;"></td>
                            <td style="text-align:right; padding:3px 4px;"></td>
                            <td style="text-align:right; padding:3px 4px; font-weight:700;"><t t-out="'{:,.2f}'.format(data['total_expenses'])"/></td>
                        </tr>

                        <!-- Spacer -->
                        <tr><td colspan="4" style="padding:6px;"></td></tr>

                        <!-- Net Profit -->
                        <tr style="border-top:2px solid #000; border-bottom:3px double #000;">
                            <td style="padding:6px 4px 6px 0; font-weight:700; font-size:11pt;">
                                Net Profit / (Loss)
                            </td>
                            <td></td><td></td>
                            <td style="text-align:right; padding:6px 4px; font-weight:700; font-size:11pt;">
                                <t t-out="'{:,.2f}'.format(data['net_profit'])"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p style="font-size:8pt; color:#555; margin-top:20px; border-top:1px solid #ccc; padding-top:6px;">
                    All amounts in <t t-out="data['currency'].name"/>.
                    Generated by FMS Accounting.
                </p>
            </div>
        </t>
        </t>
        </t>
    </template>

    <record id="action_report_fms_pl" model="ir.actions.report">
        <field name="name">Profit &amp; Loss</field>
        <field name="model">fms.report.pl</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fms_accounting.report_fms_pl_document</field>
        <field name="report_file">fms_accounting.report_fms_pl_document</field>
        <field name="binding_model_id" ref="model_fms_report_pl"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
