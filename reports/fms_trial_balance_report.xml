<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fms_trial_balance_document">
        <t t-call="web.external_layout">
            <t t-set="data" t-value="doc.get_report_data()"/>
            <div class="page">

                <div class="row mb-4">
                    <div class="col-12 text-center">
                        <h2 style="font-weight:700; margin-bottom:2px;">Trial Balance</h2>
                        <p style="color:#666; margin:0;">
                            <t t-out="data['wizard'].date_from"/> —
                            <t t-out="data['wizard'].date_to"/>
                             | 
                            <t t-out="data['wizard'].target_move == 'posted' and 'Posted Entries Only' or 'All Entries'"/>
                            <t t-if="not data['balanced']">
                                 | <span style="color:red; font-weight:600;">⚠ DOES NOT BALANCE</span>
                            </t>
                        </p>
                    </div>
                </div>

                <table class="table table-sm table-bordered" style="font-size:10px;">
                    <thead>
                        <tr style="background:#1a1a2e; color:#fff; text-align:center;">
                            <th style="width:9%;">Code</th>
                            <th style="text-align:left;">Account Name</th>
                            <th style="width:16%;">Opening Balance</th>
                            <th style="width:14%;">Debit</th>
                            <th style="width:14%;">Credit</th>
                            <th style="width:16%;">Closing Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data['rows']" t-as="row">
                            <tr t-att-style="'background:#f5f5f5;' if row_index % 2 == 0 else ''">
                                <td style="color:#777; font-size:9px;"><t t-out="row['code']"/></td>
                                <td><t t-out="row['name']"/></td>
                                <td class="text-end"
                                    t-att-style="'color:green;' if row['opening'] >= 0 else 'color:red;'">
                                    <t t-out="'{:,.2f}'.format(row['opening'])"/>
                                </td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(row['debit'])"/></td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(row['credit'])"/></td>
                                <td class="text-end"
                                    t-att-style="'color:green;' if row['closing'] >= 0 else 'color:red;'">
                                    <t t-out="'{:,.2f}'.format(row['closing'])"/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="not data['rows']">
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No account movements found for this period.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr style="background:#1a1a2e; color:#fff; font-weight:700;">
                            <td colspan="2" class="text-end">TOTALS</td>
                            <td class="text-end"><t t-out="'{:,.2f}'.format(data['total_opening'])"/></td>
                            <td class="text-end"><t t-out="'{:,.2f}'.format(data['total_debit'])"/></td>
                            <td class="text-end"><t t-out="'{:,.2f}'.format(data['total_credit'])"/></td>
                            <td class="text-end"><t t-out="'{:,.2f}'.format(data['total_closing'])"/></td>
                        </tr>
                        <t t-if="data['balanced']">
                            <tr>
                                <td colspan="6" class="text-center"
                                    style="color:green; font-size:9px; padding:4px;">
                                    ✓ Debit and Credit totals are balanced.
                                </td>
                            </tr>
                        </t>
                        <t t-if="not data['balanced']">
                            <tr>
                                <td colspan="6" class="text-center"
                                    style="color:red; font-size:9px; padding:4px; font-weight:600;">
                                    ⚠ Difference: <t t-out="'{:,.2f}'.format(abs(data['total_debit'] - data['total_credit']))"/>
                                    — investigate unbalanced journal entries.
                                </td>
                            </tr>
                        </t>
                    </tfoot>
                </table>

                <p style="font-size:9px; color:#999; margin-top:10px;">
                    All amounts in <t t-out="data['currency'].name"/>.
                    Generated by FMS Accounting — <t t-out="data['wizard'].company_id.name"/>.
                </p>
            </div>
        </t>
    </template>

    <record id="action_report_fms_trial_balance" model="ir.actions.report">
        <field name="name">Trial Balance</field>
        <field name="model">fms.report.trial.balance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fms_accounting.report_fms_trial_balance_document</field>
        <field name="report_file">fms_accounting.report_fms_trial_balance_document</field>
        <field name="binding_model_id" ref="model_fms_report_trial_balance"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
