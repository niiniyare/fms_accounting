<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_fms_trial_balance_document">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
            <t t-set="data" t-value="doc.get_report_data()"/>
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #000;">

                <!-- Company + Title -->
                <div style="text-align:center; margin-bottom:18px;">
                    <div style="font-weight:700; font-size:11pt;">
                        <t t-out="data['wizard'].company_id.name"/>
                    </div>
                    <div style="font-weight:700; font-size:11pt; margin-top:4px;">
                        TRIAL BALANCE
                    </div>
                    <div style="font-size:9pt; margin-top:3px; color:#333;">
                        <t t-out="data['wizard'].date_from"/> to <t t-out="data['wizard'].date_to"/>
                        <t t-if="data['wizard'].target_move == 'posted'"> — Posted Entries Only</t>
                        <t t-else=""> — All Entries</t>
                        <t t-if="not data['balanced']">
                            <span style="color:#c00; font-weight:700;"> — DOES NOT BALANCE</span>
                        </t>
                    </div>
                </div>

                <table style="width:100%; border-collapse:collapse; font-size:10pt;">
                    <col style="width:10%;"/>
                    <col style="width:34%;"/>
                    <col style="width:14%; text-align:right;"/>
                    <col style="width:14%; text-align:right;"/>
                    <col style="width:14%; text-align:right;"/>
                    <col style="width:14%; text-align:right;"/>
                    <thead>
                        <tr style="border-top:2px solid #000; border-bottom:2px solid #000;">
                            <th style="text-align:left; padding:4px 4px 4px 0;">Code</th>
                            <th style="text-align:left; padding:4px;">Account Name</th>
                            <th style="text-align:right; padding:4px;">Opening Balance</th>
                            <th style="text-align:right; padding:4px;">Debit</th>
                            <th style="text-align:right; padding:4px;">Credit</th>
                            <th style="text-align:right; padding:4px;">Closing Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data['rows']" t-as="row">
                            <tr t-att-style="'background:#f0f0f0;' if row_index % 2 == 0 else ''">
                                <td style="padding:2px 4px 2px 0; color:#555; font-size:9pt;"><t t-out="row['code']"/></td>
                                <td style="padding:2px 4px;"><t t-out="row['name']"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['opening'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['debit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['credit'])"/></td>
                                <td style="text-align:right; padding:2px 4px;"><t t-out="'{:,.2f}'.format(row['closing'])"/></td>
                            </tr>
                        </t>
                        <t t-if="not data['rows']">
                            <tr>
                                <td colspan="6" style="text-align:center; padding:8px; color:#777;">
                                    No account movements found for this period.
                                </td>
                            </tr>
                        </t>

                        <!-- Totals row -->
                        <tr style="border-top:2px solid #000; border-bottom:2px solid #000; font-weight:700;">
                            <td colspan="2" style="padding:4px 4px 4px 0;">TOTALS</td>
                            <td style="text-align:right; padding:4px;"><t t-out="'{:,.2f}'.format(data['total_opening'])"/></td>
                            <td style="text-align:right; padding:4px;"><t t-out="'{:,.2f}'.format(data['total_debit'])"/></td>
                            <td style="text-align:right; padding:4px;"><t t-out="'{:,.2f}'.format(data['total_credit'])"/></td>
                            <td style="text-align:right; padding:4px;"><t t-out="'{:,.2f}'.format(data['total_closing'])"/></td>
                        </tr>

                        <!-- Balance status -->
                        <t t-if="data['balanced']">
                            <tr>
                                <td colspan="6" style="text-align:center; padding:6px; font-size:9pt; color:#333;">
                                    Debit and Credit totals are balanced.
                                </td>
                            </tr>
                        </t>
                        <t t-if="not data['balanced']">
                            <tr>
                                <td colspan="6" style="text-align:center; padding:6px; font-size:9pt; color:#c00; font-weight:700;">
                                    Difference: <t t-out="'{:,.2f}'.format(abs(data['total_debit'] - data['total_credit']))"/> — investigate unbalanced journal entries.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <p style="font-size:8pt; color:#555; margin-top:20px; border-top:1px solid #ccc; padding-top:6px;">
                    All amounts in <t t-out="data['currency'].name"/>.
                    Generated by FMS Accounting.
                </p>
            </div>
        </t>
        </t>
        </t>
    </template>

    <record id="action_report_fms_trial_balance" model="ir.actions.report">
        <field name="name">Trial Balance</field>
        <field name="model">fms.report.trial.balance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fms_accounting.report_fms_trial_balance_document</field>
        <field name="report_file">fms_accounting.report_fms_trial_balance_document</field>
        <field name="binding_model_id" ref="model_fms_report_trial_balance"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
